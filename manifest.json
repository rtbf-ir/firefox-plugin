{
  "manifest_version": 3,
  "name": "Right to be forgotten",
  "version": "1.7.0",
  "description": "نداشتن امکان حذف حساب‌کاربری در بسیاری از سرویس‌ها نقض حریم‌شخصی کاربران است که با حق فراموش شدن برای حذف اطلاعات، مغایرت دارد.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["https://rtbf.ir/*"],
  "action": {
    "default_title": "rtbf.ir",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/images/logo-16.png", "32": "assets/images/logo.png", "48": "assets/images/logo-48.png" }
  },
  "background": { "scripts": ["background.js"] },
  "icons": {
    "16": "assets/images/logo-16.png",
    "32": "assets/images/logo.png",
    "48": "assets/images/logo-48.png",
    "128": "assets/images/logo-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{3bce7dcb-b74a-45f5-8296-0fe0ead6e37b}",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
